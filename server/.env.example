# ---- Server ----
PORT=4100
# Comma-separated list of allowed frontend origins (CORS)
CLIENT_ORIGIN=http://localhost:5173
# Public URL of THIS api (used to build payment return URLs). Leave blank in dev.
APP_URL=
# Public URL of the storefront (fallback for payment redirects). Leave blank in dev.
CLIENT_URL=http://localhost:5173

# ---- Auth ----
# Change this to a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret
# Default admin account created by the seed script.
ADMIN_EMAIL=admin@samijeedecor.com
ADMIN_PASSWORD=admin123

# ---- Payments ----
# 'sandbox' = use the built-in mock gateway so checkout is demoable with no keys.
# 'live'    = use the real gateways below (requires valid merchant credentials).
PAYMENTS_MODE=sandbox
CURRENCY=PKR

# JazzCash (Page Redirection) — get these from the JazzCash merchant portal.
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
# Sandbox: https://sandbox.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform/
# Live:    https://payments.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform/
JAZZCASH_POST_URL=

# Easypaisa (Easypay) — get these from the Easypaisa merchant portal.
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
# Sandbox: https://easypaystg.easypaisa.com.pk/easypay/Index.jsf
# Live:    https://easypay.easypaisa.com.pk/easypay/Index.jsf
EASYPAISA_POST_URL=
